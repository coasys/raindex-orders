---

/**
 *  Our "coupon" (the SignedContext array) will be:
 *  [0] recipient address
 *  [1] amount, a decimal float: the wei as its coefficient and -18 as its
 *      exponent, so 0xffffffee then the wei in the low 224 bits
 *  [2] expiry timestamp in seconds (a float of exponent 0 is its integer)
 *  Plus some domain separators
 *  [3] order hash
 *  [4] order owner
 *  [5] raindex (orderbook) address
 *  [6] token address
 *  [7] output vault id
 *  [8] nonce (to prevent replay attacks)
 *
 *  A claim carries this coupon signed by M of the order's N signers. Each
 *  signer signs the identical nine words. compose-rainlang.mjs writes the
 *  signer checks from --signers and --threshold where the comment below says.
 */

#orderbook-subparser !subparser on this network

#calculate-io
using-words-from orderbook-subparser

/* M-of-N signer checks, written here by compose-rainlang.mjs */

/* do the checks, on the first signer's coupon: the others are its copies */
:ensure(binary-equal-to(signed-context<0 0>() order-counterparty()) "Wrong recipient"),
:ensure(less-than(block-timestamp() signed-context<0 2>()) "Order expired"),
:ensure(binary-equal-to(signed-context<0 3>() order-hash()) "Wrong order hash"),
:ensure(binary-equal-to(signed-context<0 4>() order-owner()) "Wrong order owner"),
:ensure(binary-equal-to(signed-context<0 5>() raindex()) "Wrong orderbook"),
:ensure(binary-equal-to(signed-context<0 6>() output-token()) "Wrong output token"),
:ensure(binary-equal-to(signed-context<0 7>() output-vault-id()) "Wrong output vault id"),

/* check the nonce has not been used before */
:ensure(is-zero(get(hash(order-hash() signed-context<0 8>()))) "Nonce already used"),
:set(hash(order-hash() signed-context<0 8>()) 1),

output-amount: signed-context<0 1>(),
/* Raindex V6 takes an order only at a positive ratio: the claimer pays 1e-30
   of the input token per HOT, which the ClaimInputToken never moves */
io-ratio: 1e-30;

#handle-io
:ensure(equal-to(output-vault-decrease() signed-context<0 1>()) "Wrong output amount");
