# The network this build serves: sepolia (the default) or mainnet.
PUBLIC_NETWORK=sepolia

# A sepolia build takes TestNet's value for each of these it is not given
# (ui/src/lib/network.ts). A mainnet build needs every one: take them from the
# deploy record.
PUBLIC_TOKEN_ADDRESS=
PUBLIC_LOCK_VAULT_ADDRESS=
PUBLIC_ORDERBOOK_ADDRESS=
PUBLIC_CLAIM_ORDER_HASH=
# The claim order's coupon signers, separated by commas, and how many of them sign
# each coupon. A base-sepolia build takes the test signer alone, threshold 1, only when
# neither is set.
PUBLIC_CLAIM_SIGNERS=
PUBLIC_CLAIM_THRESHOLD=
PUBLIC_CLAIM_INTERPRETER=
PUBLIC_CLAIM_STORE=
PUBLIC_CLAIM_EXPRESSION=
PUBLIC_CLAIM_INPUT_TOKEN=

# Sepolia's runtime secrets: its RPC, and the faucet wallet's key. Fund that
# wallet with MockHOT and Sepolia ETH.
SEPOLIA_RPC_URL=https://1rpc.io/sepolia
FAUCET_PRIVATE_KEY=

# Mainnet's runtime secret: its RPC.
ETH_RPC_URL=

# true pauses Lock and the faucet. A Worker secret set by hand, never a build
# variable (README.md, Pausing the bridge).
BRIDGE_PAUSED=
