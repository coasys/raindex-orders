# The network this build serves: base-sepolia (the TestNet, chain 84532, the
# default) or mainnet.
PUBLIC_NETWORK=base-sepolia

# A base-sepolia build takes TestNet's value, its deploy on Base Sepolia, for each
# of these it is not given (ui/src/lib/network.ts). A mainnet build needs every
# one: take them from the deploy record.
PUBLIC_TOKEN_ADDRESS=
PUBLIC_LOCK_VAULT_ADDRESS=
PUBLIC_ORDERBOOK_ADDRESS=
PUBLIC_CLAIM_ORDER_HASH=
PUBLIC_CLAIM_SIGNER=
PUBLIC_CLAIM_INTERPRETER=
PUBLIC_CLAIM_STORE=
PUBLIC_CLAIM_BYTECODE=
PUBLIC_CLAIM_INPUT_TOKEN=

# Base Sepolia's runtime secrets: its RPC, and the faucet wallet's key. Fund that
# wallet with mock HOT and Base Sepolia ETH.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
FAUCET_PRIVATE_KEY=

# Mainnet's runtime secret: its RPC.
ETH_RPC_URL=

# true pauses Lock and the faucet. A Worker secret set by hand, never a build
# variable (README.md, Pausing the bridge).
BRIDGE_PAUSED=
